APP_ENV=production
APP_DEBUG=false
APP_URL=https://atlas.example.com
SESSION_SECURE=true
FORCE_HTTPS=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atlas
DB_USER=atlas_application_user
